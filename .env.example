# CrawlForge MCP Server Environment Configuration
# Copy this file to .env and fill in your values

# API Authentication (for users)
# Get your API key from: https://www.crawlforge.dev/dashboard/api-keys
CRAWLFORGE_API_KEY=your_api_key_here

# Optional: Custom API endpoint (for enterprise deployments)
# CRAWLFORGE_API_URL=https://api.crawlforge.dev

# Search Provider Configuration
# Google Search is used via CrawlForge API proxy (no additional config needed)
# For Creator Mode, direct Google Search API access requires:
# GOOGLE_API_KEY=your_google_api_key
# GOOGLE_SEARCH_ENGINE_ID=your_search_engine_id

# SERP Rank Tracking (serp_rank tool) — OPTIONAL
# Powers REAL Google organic rank lookups via DataForSEO. Billed to your own
# DataForSEO account (~US$0.002 per 10 results of depth — $0.004 at the
# default depth of 20, $0.02 at depth 100), separate from CrawlForge credits.
# Without these, serp_rank returns { configured:false } and charges 0 credits.
# Get credentials at: https://app.dataforseo.com/api-access
# DATAFORSEO_LOGIN=your_dataforseo_login
# DATAFORSEO_PASSWORD=your_dataforseo_password
# Live Advanced runs a real-time Google scrape, so latency swings with their
# capacity and with depth: ~13-15s at depth 10, and 30s to over 60s for the same
# depth-100 request. Raise this if serp_rank reports timeouts (default 120000).
# DATAFORSEO_TIMEOUT_MS=120000

# reddit_search per-request timeout against the community archives (default 30000)
# REDDIT_SEARCH_TIMEOUT_MS=30000

# Optional: reddit_search official-API path (prototype). Supply your OWN Reddit
# app credentials to read Reddit's official Data API (live scores, complete
# comment trees) on your app's own free 100-QPM quota, instead of the community
# archives. Absent (the default), reddit_search is unchanged and needs nothing.
# Serves posts search/listings and thread reads; comment full-text search and
# date-range filters still route to the archives. NOTE: Reddit closed
# self-service app signup on 2025-11-11 (Responsible Builder Policy) — only
# pre-Nov-2025 apps still have working credentials; new access needs an approval
# ticket. Setup + ticket links: docs/reddit-access-and-oauth.md section 4.
# REDDIT_CLIENT_ID=your_reddit_app_client_id
# REDDIT_CLIENT_SECRET=your_reddit_app_client_secret
# REDDIT_USER_AGENT=CrawlForge-MCP/5.1.0 (by /u/yourname)

# Creator Mode (KEEP THIS SECRET!)
# This is ONLY for the package creator to enable unlimited access
# DO NOT SHARE THIS SECRET WITH ANYONE
# CRAWLFORGE_CREATOR_SECRET=your-creator-secret-uuid-here

# Optional: LLM keys for deep_research internal synthesis.
# When set, deep_research will produce a fully synthesized report internally.
# When NOT set, deep_research returns raw evidence (sources + extracted
# content + top sentences) designed for the calling LLM to synthesize.
# Leave unset if you call this tool from a chat client like Claude Code on
# a Max/Pro subscription — the calling LLM will do the synthesis for free.
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# Performance Settings (optional)
# MAX_WORKERS=10
# QUEUE_CONCURRENCY=10
# CACHE_TTL=3600000
# RATE_LIMIT_REQUESTS_PER_SECOND=10

# Development Settings
# NODE_ENV=development
